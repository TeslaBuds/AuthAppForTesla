{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "Packages/TeslaAuthKit",
    },
  ],
  "files": [
    {
      "kind": "variant-group",
      "name": "InfoPlist.strings",
      "target-membership": [
        "AuthAppForTesla/resources",
        "AuthAppForTeslaMac/resources",
      ],
      "children": [
        {
          "path": "en.lproj/InfoPlist.strings",
        },
      ],
    }, {
      "kind": "group",
      "path": "AuthAppForTesla",
      "children": [
        { "path": "AuthAppForTesla.entitlements" },
        { "path": "RootView.swift", "target-membership": [ "AuthAppForTesla/compile-sources" ] },
        { "path": "AuthAppForTeslaApp.swift", "target-membership": [ "AuthAppForTesla/compile-sources" ] },
        { "path": "Info.plist" },
        {
          "kind": "group",
          "path": "Preview Content",
          "children": [
            { "path": "Preview Assets.xcassets", "target-membership": [ "AuthAppForTesla/resources" ] },
          ],
        },
        { "path": "TipJarProducts.storekit", "target-membership": [ "AuthAppForTesla/resources" ] },
        { "path": "PrivacyInfo.xcprivacy", "target-membership": [ "AuthAppForTesla/resources" ] },
      ],
    },
    { "kind": "folder", "path": "Shared", "target-membership": [ "AuthAppForTesla", "AuthAppForTeslaMac" ] },
    { "kind": "folder", "path": "Auth for Tesla Tests", "target-membership": [ "Auth for Tesla Tests" ] },
    { "kind": "folder", "path": "Auth for Tesla UI Tests", "target-membership": [ "Auth for Tesla UI Tests" ] },
    { "kind": "folder", "path": "AuthAppForTeslaMac", "target-membership": [ "AuthAppForTeslaMac" ] },
    { "kind": "folder", "path": "AuthAppForTeslaMacTests", "target-membership": [ "AuthAppForTeslaMacTests" ] },
    { "kind": "folder", "path": "AuthAppForTeslaMacUITests", "target-membership": [ "AuthAppForTeslaMacUITests" ] },
    {
      "kind": "folder",
      "path": "AuthForTeslaWidgets",
      "target-membership": [
        "AuthForTeslaWidgetsExtension",
        "AuthForTeslaWidgetsMacExtension",
      ],
      "membership-exceptions": [
        {
          "target": "AuthForTeslaWidgetsExtension",
          "exclusions": [
            "Info.plist",
          ],
        }, {
          "target": "AuthForTeslaWidgetsMacExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        {
          "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework",
          "target-membership": [
            "AuthForTeslaWidgetsExtension/frameworks",
            "AuthForTeslaWidgetsMacExtension/frameworks",
          ],
        }, {
          "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework",
          "target-membership": [
            "AuthForTeslaWidgetsExtension/frameworks",
            "AuthForTeslaWidgetsMacExtension/frameworks",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/AuthAppForTesla.app", "id": "EA63696E25CAB11D000216BF", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/Auth for Tesla Tests.xctest", "id": "EA5640852F5D996D00A50586", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/Auth for Tesla UI Tests.xctest", "id": "EA5640922F5D998300A50586", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/Auth for Tesla.app", "id": "EA73FFC5306D0E2C00BC6E17", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/AuthAppForTeslaMacTests.xctest", "id": "EA73FFD1306D0E2D00BC6E17", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/AuthAppForTeslaMacUITests.xctest", "id": "EA73FFDB306D0E2D00BC6E17", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/AuthForTeslaWidgetsExtension.appex", "id": "EAC281A0306D26A90024D0BA", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "AuthAppForTesla/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/AuthForTeslaWidgetsMacExtension.appex", "id": "EAC281BA306D26B50024D0BA", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "AuthAppForTeslaMac/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    }, {
      "path": "AuthAppForTesla.icon",
      "target-membership": [
        "AuthAppForTesla/resources",
        "AuthAppForTeslaMac/resources",
      ],
    },
  ],
  "targets": [
    {
      "name": "AuthAppForTesla",
      "id": "EA63696D25CAB11D000216BF",
      "product": "Products/AuthAppForTesla.app",
      "product-type": "application",
      "dependencies": [
        "AuthForTeslaWidgetsExtension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "TeslaAuthKit",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AuthAppForTesla",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "GlobalAccentColor",
        "CODE_SIGN_ENTITLEMENTS": "AuthAppForTesla/AuthAppForTesla.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "34",
        "DEVELOPMENT_ASSET_PATHS": "\"AuthAppForTesla/Preview Content\"",
        "ENABLE_PREVIEWS": "YES",
        "INFOPLIST_FILE": "AuthAppForTesla/Info.plist",
        "IPHONEOS_DEPLOYMENT_TARGET": "26.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "3.1",
        "PRODUCT_BUNDLE_IDENTIFIER": "dk.kimhansen.AuthAppForTesla",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG OAUTHAVAILABLE",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Release]": "OAUTHAVAILABLE",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
